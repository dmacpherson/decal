#!/usr/bin/env bash
# shellcheck disable=SC2030,SC2031,SC1091  # modules run in isolated subshells; module files sourced at runtime
# decal: add/remove/report system customizations. See README.md.
set -euo pipefail
LS_REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export LS_REPO
MODULES_DIR="${DECAL_MODULES_DIR:-$LS_REPO/modules}"
# shellcheck source=lib/common.sh
source "$LS_REPO/lib/common.sh"

usage() {
  cat >&2 <<'EOF'
usage: ./decal [--dry-run] [--verbose] [--force] [--profile DIR] [--tags T,..] [--only T] <command> [module...]
  (add/apply skip modules already applied with unchanged settings; --force applies them anyway)
  --tags dev,laptop          also the profile's [section.dev] / [section.laptop] settings; --tags all = every tag
                             (without --tags: only the untagged settings)
  --only dev                 just the modules with a [section.dev], with dev's settings (implies --tags dev);
                             with remove: take away what dev adds (whole module if it is only there through dev)
  (no command, in a terminal) the menu: apply, stamp, remove, update (also: decal ui)
  list                       modules and descriptions
  status [module...]         installed / partial / not-installed / stale / not in profile
  tags                       the tags your profile uses, and which sections have them
  add    <module...|all>     apply (idempotent); all = every module in your profile
  remove <module...|all>     undo exactly what add did
  apply  <source> [module...]  make it the active profile, then add everything in it (or just those modules).
                             source: a folder, a .tar.gz/.tgz/.zip, owner/repo or any GitHub link, an https://
                             link to an archive, a git URL. Someone else's profile: decal asks first (--yes skips)
                             (never removes anything; use remove, or [apps] remove-* lists)
  use    <profile source>    make it the active profile without applying anything
  whoami                     the GitHub account of the key decal would use
  profiles [--json] [--sign-in]  the profiles decal can see: yours on GitHub, stamps on this machine, USB
                             sticks, recently used (--sign-in: sign in to GitHub first if there's no key)
  stamp  [MODULE...] [PATH] [-gh [REPO]] save this machine's setup (what's changed from default) as a profile:
                             ~/decal-$USER.tar.gz, or PATH (a .tar.gz, or a folder); -dr / --dry-run shows it
                             without saving; -gh / --github also puts it in a private GitHub repo (REPO, or
                             decal-$USER), one commit per stamp (--public: a public repo)
  new NAME [--from this-machine|PROFILE|empty] [--to github|file[:PATH]|stick] [--public] [--use]
                             a new profile: a stamp of this machine (default), a copy of PROFILE, or a starter
                             with everything commented out; on GitHub (default: a private repo), in a file
                             (~/NAME.tar.gz) or on the USB stick. Never overwrites. --use: make it active
  usb [--from SRC] [--how saved-key|sign-in|copy|latest] [--decal newest|copy|online] [--arm] [--to WHERE] [--yes]
                             put decal on a USB stick (or --to folder[:PATH]): double-click Decal on any Linux PC to
                             get decal, the profile and the menu. In a terminal with no options: asks step by step
  fetch  [module...]         pre-download sources (themes, fonts, ...)
  capture <module>           print current config to copy into your profile
  update                     update decal now (installs from install.sh also update themselves on every run;
                             --no-update skips that once)
  version                    the installed version
EOF
  exit 1
}

# val OPTION VALUE WHAT : an option given without its value says what it needs (not bash's "parameter null")
val() { [[ -n $2 ]] || die "$1 needs $3"; }

ORIG_ARGS=("$@")
args=(); OPT_PROFILE=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --dry-run|-dr) export LS_DRY_RUN=1 ;;
    -v|--verbose) export DECAL_VERBOSE=1 ;;
    -f|--force) export DECAL_FORCE=1 ;;
    --profile) val "$1" "${2:-}" "a profile folder"; OPT_PROFILE=$2; shift ;;
    --tags) val "$1" "${2:-}" "a tag list, e.g. --tags dev"; DECAL_TAGS=$2; export DECAL_TAGS; shift ;;
    --only) val "$1" "${2:-}" "a tag"; DECAL_ONLY=$2; export DECAL_ONLY; shift ;;
    --no-update) export DECAL_NO_UPDATE=1 ;;
    -y|--yes) export DECAL_YES=1 ;;
    -h|--help) usage ;;
    *) args+=("$1") ;;
  esac; shift
done
set -- "${args[@]+"${args[@]}"}"
if [[ $# -eq 0 && -t 0 && -t 1 ]]; then set -- ui; fi   # bare `decal` in a terminal: the menu
[[ $# -ge 1 ]] || usage
cmd=$1; shift

# installed with install.sh (not a git checkout): every run first updates decal if a newer version is out, then
# runs the command on it. Offline or GitHub unreachable: carries on. --no-update / DECAL_NO_UPDATE=1 skip it.
_installer() { local t; t=$(mktemp "${TMPDIR:-/tmp}/decal-install.XXXXXX"); cp "$LS_REPO/install.sh" "$t"; echo "$t"; }   # a copy: the update replaces this folder
self_update() {
  [[ -e $LS_REPO/.installed && -z ${DECAL_NO_UPDATE:-} && -z ${DECAL_LOGGING:-} ]] || return 0
  local new t; new=$(DECAL_HOME=$LS_REPO timeout 30 bash "$LS_REPO/install.sh" --check 2>/dev/null) || return 0
  info "decal $new is out (you have $(cat "$LS_REPO/VERSION" 2>/dev/null)): updating first"
  t=$(_installer)
  if DECAL_HOME=$LS_REPO bash "$t" --update; then rm -f "$t"; DECAL_NO_UPDATE=1 exec "$LS_REPO/decal" "${ORIG_ARGS[@]}"; fi
  rm -f "$t"; warn "the update failed; carrying on with this version"
}
case $cmd in
  update)
    [[ -e $LS_REPO/.installed ]] || die "$LS_REPO is a git checkout: update it with git pull (decal update is for installs made with install.sh)"
    t=$(_installer); DECAL_HOME=$LS_REPO bash "$t" --update; rc=$?; rm -f "$t"; exit "$rc" ;;
  version)
    if [[ -e $LS_REPO/.installed ]]; then echo "decal $(cat "$LS_REPO/VERSION" 2>/dev/null) ($(cat "$LS_REPO/.channel" 2>/dev/null || echo latest))"
    else echo "decal (git checkout at $LS_REPO)"; fi
    exit 0 ;;
esac
self_update
PROFILE_HOME="${DECAL_PROFILE_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/decal/profile}"
PROFILE_DIR="${OPT_PROFILE:-${DECAL_PROFILE:-$PROFILE_HOME}}"; export PROFILE_DIR

# add/remove/apply: show the output and keep a plain-text copy (a GNOME Shell crash can take the terminal with it)
if [[ $cmd == @(add|remove|apply) && -z ${DECAL_LOGGING:-} ]]; then
  logdir="$LS_USER_STATE/logs"; mkdir -p "$logdir"
  logf="$logdir/decal-$(date +%Y%m%d-%H%M%S)-$$.log"
  ln -sfn "$(basename "$logf")" "$logdir/last.log"
  { printf 'decal %s  (%s)\n' "${ORIG_ARGS[*]}" "$(date)"; } > "$logf"
  # in a terminal: a spinner line per module, the details only in the log (--verbose shows everything)
  if [[ -t 2 && -z ${DECAL_VERBOSE:-} ]]; then export DECAL_FANCY=1; fi
  set +e
  DECAL_LOG="$logf" DECAL_LOGGING=1 "$LS_REPO/decal" "${ORIG_ARGS[@]}" 2>&1 \
    | awk -v f="$logf" '{ print; fflush(); l = $0; gsub(/\033\[[0-9;]*m/, "", l); print l >> f; fflush(f) }'
  rc=${PIPESTATUS[0]}
  # shellcheck disable=SC2012  # our own names: decal-<date>-<pid>.log
  ls -1t "$logdir"/decal-*.log 2>/dev/null | tail -n +21 | xargs -r rm -f   # keep the last 20 runs
  printf '    log: %s\n' "$logf" >&2
  exit "$rc"
fi

if (( ${DECAL_FAKE_EUID:-$EUID} == 0 )) && [[ ${DECAL_ALLOW_ROOT:-0} != 1 ]]; then
  die "run as your normal user, not root; privileged steps use sudo themselves"
fi

all_modules() { local d; for d in "$MODULES_DIR"/*/; do [[ -f $d/module.sh ]] && basename "$d"; done; }
resolve() { # args -> validated module names (all expands)
  local m
  if [[ $# -eq 1 && $1 == all ]]; then all_modules; return; fi
  for m in "$@"; do [[ -f $MODULES_DIR/$m/module.sh ]] || die "unknown module: $m"; echo "$m"; done
}
pyprof() { python3 "$LS_REPO/lib/profile.py" "$@" --profile "$PROFILE_DIR" --modules "$MODULES_DIR"; }
# tags (see lib/profile.py): DECAL_TAGS picks them for every profile read; --only TAG implies it
if [[ -n ${DECAL_ONLY:-} ]]; then
  [[ $DECAL_ONLY != *,* ]] || die "--only takes one tag (or all)"
  [[ ,${DECAL_TAGS:-}, == *,"$DECAL_ONLY",* || ,${DECAL_TAGS:-}, == *,all,* ]] || DECAL_TAGS="${DECAL_TAGS:+$DECAL_TAGS,}$DECAL_ONLY"
  export DECAL_TAGS
fi
module_tags() { DECAL_TAGS="" pyprof tags "$1" 2>/dev/null; }
# check_tags : every tag asked for is in the profile (add/apply get this from the profile check)
check_tags() {
  [[ -n ${DECAL_TAGS:-} ]] || return 0
  local t known; known=$(DECAL_TAGS="" pyprof tags 2>/dev/null) || return 0   # an unreadable profile: remove/status cope
  for t in ${DECAL_TAGS:+${DECAL_TAGS//,/ }}; do
    [[ $t == all ]] || grep -qxF "$t" <<<"$known" || die "no section of the profile has the tag '$t' (tags in the profile: $(paste -sd, - <<<"${known:-none}"))"
  done
}
# has_tag NAME : the module has a section for --only's tag (any tag for --only all)
has_tag() { local t; t=$(module_tags "$1"); [[ -n $t ]] && { [[ $DECAL_ONLY == all ]] || grep -qxF "$DECAL_ONLY" <<<"$t"; }; }
only_filter() { local m; while IFS= read -r m; do [[ -z $m ]] || { [[ -z ${DECAL_ONLY:-} ]] || has_tag "$m"; } && echo "$m"; done; return 0; }
in_profile() { pyprof shell "$1" 2>/dev/null | grep -qx 'declare -g P__in_profile=true'; }
profile_modules() { local m; for m in $(all_modules); do in_profile "$m" && echo "$m"; done; return 0; }
# module_field NAME VAR : read a variable from a module without running it (profile vars loaded)
module_field() { ( set +u; cd "$MODULES_DIR/$1" && export MODULE_DIR="$PWD"; eval "$(pyprof shell "$1" 2>/dev/null)"; source ./module.sh >/dev/null 2>&1; eval "printf '%s' \"\${$2:-}\"" ); }

# run_module ACTION NAME : isolated subshell with the module's profile variables
# a module named on its own (decal add ollama) that is only in the profile through tags gets its own tags'
# settings, without the rest of those tags (MODULE_TAGS[name]); every profile read for it uses them
declare -A MODULE_TAGS=()
tags_for() { local t=${DECAL_TAGS:-}; if [[ -n ${MODULE_TAGS[$1]:-} ]]; then t="${t:+$t,}${MODULE_TAGS[$1]}"; fi; printf '%s' "$t"; }
run_module() {
  local action=$1 name=$2
  (
    set -euo pipefail
    unset GITHUB_TOKEN GH_TOKEN   # no module needs a GitHub key (CLAUDE.md → Security: keys only where needed)
    DECAL_TAGS=$(tags_for "$name"); export DECAL_TAGS
    export MODULE_DIR="$MODULES_DIR/$name"
    source "$LS_REPO/lib/common.sh"
    source "$LS_REPO/lib/platform.sh"
    platform_load
    # remove/status work from recorded state: a broken profile falls back to schema defaults
    # drop (remove --only TAG): the module gets just the list items the tag adds
    local drop=(); if [[ $action == drop ]]; then drop=(--drop "$DECAL_ONLY"); fi
    if [[ $action == stamp ]]; then drop=(--defaults); fi   # stamp reads the machine: schema defaults only
    if ! penv=$(pyprof shell "$name" "${drop[@]}" 2>"$LS_RUNTMP/perr"); then
      if [[ $action != remove && $action != status ]]; then cat "$LS_RUNTMP/perr" >&2; exit 3; fi
      warn "$(tail -1 "$LS_RUNTMP/perr") -- using defaults and what was recorded at add time"
      penv=$(pyprof shell "$name" --defaults) || exit 3
    fi
    eval "$penv"
    cd "$MODULE_DIR"
    source ./module.sh
    declare -F "module_$action" >/dev/null || { warn "$name has no $action"; exit 2; }
    "module_$action"
  )
}
# a module is up to date when what its add depends on (settings, the profile files they point to, decal's code)
# is unchanged since it was last applied, and its status still says installed: then add is skipped
APPLIED="$LS_USER_STATE/applied"
fingerprint() { DECAL_TAGS=$(tags_for "$1") python3 "$LS_REPO/lib/fingerprint.py" "$1" --profile "$PROFILE_DIR" --modules "$MODULES_DIR" 2>/dev/null; }
up_to_date() {
  [[ ${DECAL_FORCE:-} != 1 && -r $APPLIED/$1 ]] || return 1
  [[ $(fingerprint "$1") == "$(cat "$APPLIED/$1")" ]] || return 1
  local st; st=$(run_module status "$1" 2>/dev/null) || return 1
  [[ $st == installed* ]]
}
# do_modules ACTION NAME... : run in order (remove: caller passes reverse order); stop at first failure
do_modules() {
  local action=$1 m rc need_sudo=0 skip=" " todo=(); shift
  (( $# )) || return 0
  if [[ $action == add ]]; then
    for m in "$@"; do if up_to_date "$m"; then skip+="$m "; else todo+=("$m"); fi; done
  else todo=("$@"); fi
  if [[ $action == add && ${LS_DRY_RUN:-0} != 1 && -n $LS_SUDO ]]; then
    for m in "${todo[@]}"; do
      if [[ $(module_field "$m" MODULE_NEEDS_ROOT) == 1 ]]; then "$LS_SUDO" -v || die "sudo needed"; need_sudo=1; break; fi
    done
  fi
  local keeper=""
  if [[ ${DECAL_FANCY:-} == 1 && -n $LS_SUDO ]] && "$LS_SUDO" -n true 2>/dev/null; then
    # keep sudo's timestamp fresh: a password prompt would be hidden behind the spinner
    ( while sleep 60; do "$LS_SUDO" -n -v 2>/dev/null || exit 0; done ) & keeper=$!
  fi
  for m in "$@"; do
    if [[ $skip == *" $m "* ]]; then
      if [[ ${DECAL_FANCY:-} == 1 ]]; then printf '\033[32m✓\033[0m add %s \033[2mup to date\033[0m\n' "$m"
      else info "add $m: up to date (--force applies it anyway)"; fi
      continue
    fi
    # something may have ended the sudo session (brew does): ask here, not behind a module's spinner
    if (( need_sudo )) && ! "$LS_SUDO" -n true 2>/dev/null; then
      info "sudo needs your password again"; "$LS_SUDO" -v || die "sudo needed"
    fi
    if [[ ${DECAL_FANCY:-} == 1 && -n ${DECAL_LOG:-} ]]; then
      set +e; run_fancy "$action" "$m"; rc=$?; set -e
    else
      info "$action $m"
      # not "run_module ... || die": that context disables set -e inside the subshell
      set +e; run_module "$action" "$m"; rc=$?; set -e
    fi
    if (( rc != 0 )); then [[ -z $keeper ]] || kill "$keeper" 2>/dev/null; die "$action $m failed (stopped; later modules not run)"; fi
    if [[ ${LS_DRY_RUN:-0} != 1 ]]; then
      if [[ $action == add ]]; then mkdir -p "$APPLIED"; fingerprint "$m" > "$APPLIED/$m" || rm -f "$APPLIED/$m"
      elif [[ $action == remove || $action == drop ]]; then rm -f "$APPLIED/$m"; fi
    fi
  done
  [[ -z $keeper ]] || kill "$keeper" 2>/dev/null
  return 0
}
# run_fancy ACTION NAME : run a module showing one spinner line (with the step it's on, see step()) on the terminal;
# its notes/warnings/errors are printed, everything else goes to $DECAL_LOG; on failure its last lines are shown
run_fancy() {
  local action=$1 m=$2 start=$SECONDS frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏' i=0 line plain last="" rc cols out="$LS_RUNTMP/module.out"
  cols=$(tput cols 2>/dev/null < /dev/tty || echo 80); : > "$out"
  printf '==> %s %s\n' "$action" "$m" >> "$DECAL_LOG"
  { run_module "$action" "$m" 2>&1; echo "$?" > "$LS_RUNTMP/rc"; } | {
    while :; do
      if IFS= read -r -t 0.1 line; then
        line=${line//$'\r'/}; plain=$line
        while [[ $plain =~ $'\e'\[[0-9\;]*m ]]; do plain=${plain/"${BASH_REMATCH[0]}"/}; done
        if [[ $plain =~ ^(==\>|warning:|error:) ]]; then printf '\r\033[K' > /dev/tty; printf '%s\n' "$line"
        elif [[ $plain == '::step:: '* ]]; then last=${plain#::step:: }; printf '    %s\n' "$last" | tee -a "$out" >> "$DECAL_LOG"
        else printf '%s\n' "$plain" | tee -a "$out" >> "$DECAL_LOG"; fi
      elif (( $? <= 128 )); then break; fi
      printf '\r\033[K\033[36m%s\033[0m %s %s \033[2m%ss  %s\033[0m' "${frames:i++%10:1}" "$action" "$m" \
        "$((SECONDS - start))" "${last:0:$((cols > 40 ? cols - 30 - ${#m} : 10))}" > /dev/tty
    done
  }
  rc=$(cat "$LS_RUNTMP/rc" 2>/dev/null || echo 1)
  printf '\r\033[K' > /dev/tty
  if (( rc == 0 )); then printf '\033[32m✓\033[0m %s %s \033[2m%ss\033[0m\n' "$action" "$m" "$((SECONDS - start))"
  else printf '\033[31m✗\033[0m %s %s\n' "$action" "$m"; tail -n 15 "$out" | sed 's/^/    /'; fi
  return "$rc"
}
# remember_active : after a successful add/apply, the active profile's source goes in the recently-used list (so
# it counts as yours from now on). Only the active profile at $PROFILE_HOME, never a dry run.
remember_active() {
  [[ ${LS_DRY_RUN:-0} != 1 && $PROFILE_DIR == "$PROFILE_HOME" ]] || return 0
  local src=""
  if [[ -L $PROFILE_HOME ]]; then src=$(readlink -f "$PROFILE_HOME")
  elif [[ -r $PROFILE_HOME/.decal-source ]]; then src=$(cat "$PROFILE_HOME/.decal-source")
  elif [[ -d $PROFILE_HOME/.git ]]; then src=$(git -C "$PROFILE_HOME" remote get-url origin 2>/dev/null || true); fi
  if [[ -n $src ]]; then python3 "$LS_REPO/lib/source.py" remember "$src" || true; fi
}
# the tags this machine's last add/apply used (the menu pre-ticks them; the command line never reads them)
remember_tags() { if [[ ${LS_DRY_RUN:-0} != 1 ]]; then mkdir -p "$LS_USER_STATE"; printf '%s\n' "${DECAL_TAGS:-}" > "$LS_USER_STATE/tags"; fi; }
INSTALL_URL="https://dmacpherson.github.io/decal/install"
# module_has NAME FUNC : the module defines FUNC
module_has() { ( cd "$MODULES_DIR/$1" && export MODULE_DIR="$PWD"; set +u; source ./module.sh >/dev/null 2>&1; declare -F "$2" >/dev/null ); }
# do_stamp [PATH] [-gh [REPO]] [--public] : this machine's setup, changed from default only, as a profile.
# Each module's module_stamp reads the machine (prints its TOML, files go to $STAMP_DIR, notes via stamp_note).
# A module decal set up from your profile that is still in place is taken from the profile as you wrote it
# (tags, sources, comments aside) unless it sets STAMP_LIVE=1 (those compare the machine with the defaults).
do_stamp() {
  local dest="" gh=0 repo="" public=0 signed=0 me m frag st rc from only=()
  while (( $# )); do
    case $1 in
      -gh|--github) gh=1
        if [[ ${2:-} =~ ^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)?$ && ${2:-} != *.tar.gz && ${2:-} != *.tgz ]]; then repo=$2; shift; fi ;;
      --github=*) gh=1; repo=${1#--github=} ;;
      --public) public=1 ;;
      -*) die "stamp: unknown option $1" ;;
      *) if [[ $1 != */* && $1 != *.* && -f $MODULES_DIR/$1/module.sh ]]; then only+=("$1")   # a module name
         else [[ -z $dest ]] || die "stamp: one place to save it (got $dest and $1)"; dest=$1; fi ;;
    esac; shift
  done
  me=${USER:-$(id -un)}
  [[ -n $dest ]] || dest="$HOME/decal-$me.tar.gz"
  [[ -n $repo ]] || repo="decal-$me"
  export STAMP_DIR="$LS_RUNTMP/stamp/profile" STAMP_NOTES="$LS_RUNTMP/stamp/notes"
  local body="$LS_RUNTMP/stamp/body.toml"; mkdir -p "$STAMP_DIR"; : > "$STAMP_NOTES"; : > "$body"
  info "stamping this machine: only what's changed from the defaults"
  for m in $(all_modules); do
    [[ $(module_field "$m" STAMP_SKIP) != 1 ]] || continue
    if (( ${#only[@]} )) && ! printf '%s\n' "${only[@]}" | grep -qxF "$m"; then continue; fi   # decal stamp MODULE...
    frag=""; from=0
    if [[ -f $PROFILE_DIR/profile.toml && -r $APPLIED/$m && $(module_field "$m" STAMP_LIVE) != 1 ]] && DECAL_TAGS=all in_profile "$m"; then
      st=$(DECAL_TAGS=all run_module status "$m" 2>/dev/null || true); [[ $st != installed* ]] || from=1
    fi
    if (( from )); then
      frag=$(python3 "$LS_REPO/lib/stamp.py" section "$m" --profile "$PROFILE_DIR" --modules "$MODULES_DIR" --to "$STAMP_DIR") \
        || die "stamp: could not copy [$m] from your profile"
      if [[ -n $frag ]]; then echo "$m: your profile's settings (decal set it up; tags kept)" >> "$STAMP_NOTES"; fi
    elif module_has "$m" module_stamp; then
      set +e; frag=$(run_module stamp "$m" 2>"$LS_RUNTMP/err"); rc=$?; set -e
      if (( rc != 0 )); then warn "stamp $m: $(tail -1 "$LS_RUNTMP/err")"; frag=""; fi
    fi
    if [[ -n $frag ]]; then printf '%s\n\n' "$frag" >> "$body"; fi
  done
  [[ -s $body ]] || die "nothing to stamp: this machine is at its defaults"
  { printf '# decal profile, stamped by %s on %s: only what differed from the defaults.\n' "$me" "$(date +%F)"
    printf '# Apply it anywhere: decal apply <this folder, its .tar.gz, or github:owner/repo>. Edit freely.\n\n'
    cat "$body"; } > "$STAMP_DIR/profile.toml"
  DECAL_TAGS="" python3 "$LS_REPO/lib/profile.py" check --profile "$STAMP_DIR" --modules "$MODULES_DIR" \
    || die "the stamp isn't a valid profile (a decal bug: please report it); nothing was saved"
  info "in this stamp:"; sed 's/^/    /' "$STAMP_NOTES" >&2
  if [[ ${LS_DRY_RUN:-0} == 1 ]]; then printf '\n'; cat "$STAMP_DIR/profile.toml"; info "dry run: nothing saved"; return 0; fi
  local tok=""
  if (( gh )); then   # the token first: the README names the repo, and a wrong token shouldn't come after the work
    tok=$(gh_write_token)
    local why="" rc=0
    if [[ -n $tok ]]; then   # a key that's already there: can it save to the repo? (offline: let the push say)
      why=$(GITHUB_TOKEN=$tok python3 "$LS_REPO/lib/auth.py" check "$repo" --need write --may-create 2>&1) || rc=$?
      if (( rc >= 10 && rc <= 12 )); then warn "$why"; tok=""; else why=""; fi
    fi
    if [[ -z $tok ]]; then
      if ! gh_auth "$repo" write --may-create; then
        [[ -z $why ]] || die "GitHub didn't accept the token, and there's no terminal to sign in on (the token needs permission to create repos and write their contents)"
        die "no GitHub key: sign in when asked, set GITHUB_TOKEN, or log in with gh auth login"
      fi
      tok=$GITHUB_TOKEN; signed=1
    fi
    if [[ $repo != */* ]]; then
      local who; who=$(GITHUB_TOKEN=$tok python3 "$LS_REPO/lib/github.py" whoami) || die "GitHub didn't accept the token (the token needs permission to create repos and write their contents)"
      repo="$who/$repo"
    fi
  fi
  local src; if (( gh )); then src="github:$repo"; else src=$(basename "$dest"); fi
  # shellcheck disable=SC2016  # Markdown backticks, not command substitution
  { printf '# My Linux setup\n\nA [decal](https://github.com/dmacpherson/decal) profile: `decal stamp` saved what was changed from the defaults on %s.\n\n' "$(date +%F)"
    # shellcheck disable=SC2016
    printf '## Put it on a machine\n\n```bash\ncurl -fsSL %s | bash -s -- %s\n```\n\n' "$INSTALL_URL" "$src"
    printf '## In it\n\n'; sed 's/^/- /' "$STAMP_NOTES"; } > "$STAMP_DIR/README.md"
  if [[ $dest == *.tar.gz || $dest == *.tgz ]]; then
    mkdir -p "$(dirname "$dest")"
    if [[ -e $dest ]]; then mv -f "$dest" "$dest.old"; fi
    tar -czf "$dest" -C "$STAMP_DIR" .
  else   # a folder: a new one, or one an earlier stamp made
    if [[ -e $dest && ! -e $dest/.decal-stamp && -n $(ls -A "$dest" 2>/dev/null) ]]; then die "$dest isn't empty and isn't an earlier stamp: not writing into it"; fi
    # write new, then swap: the earlier stamp stays whole until the new one is complete
    rm -rf "$dest.decal-new" "$dest.decal-old"; mkdir -p "$dest.decal-new"
    cp -a "$STAMP_DIR/." "$dest.decal-new/" || { rm -rf "$dest.decal-new"; die "could not save the stamp to $dest (the earlier one is untouched)"; }
    : > "$dest.decal-new/.decal-stamp"
    if [[ -e $dest ]]; then mv "$dest" "$dest.decal-old"; fi
    mv "$dest.decal-new" "$dest"; rm -rf "$dest.decal-old"
  fi
  info "saved: $dest   (apply it anywhere: decal apply $dest)"
  (( gh )) || return 0
  local r
  if (( public )); then warn "a public repo: anyone can see what's in it (pictures, app list, settings)"; fi
  local pub=(); if (( public )); then pub=(--public); fi
  r=$(GITHUB_TOKEN=$tok python3 "$LS_REPO/lib/github.py" push "$STAMP_DIR" "$repo" "${pub[@]}" --message "decal stamp $(date '+%F %H:%M')") \
    || { if (( signed )); then local u; u=$(python3 "$LS_REPO/lib/auth.py" install-url --need write 2>/dev/null) && info "Decal Profile Write needs access to $repo: $u"; fi
         die "could not save the stamp to GitHub (it is saved at $dest)"; }
  info "on GitHub: https://github.com/$r"
  info "on another machine: curl -fsSL $INSTALL_URL | bash -s -- github:$r"
}
# do_new NAME [--from this-machine|PROFILE|empty] [--to github|file[:PATH]|stick] [--public] [--use] : a new profile.
# Never overwrites: an existing repo, file or stick profile stops it before any work.
do_new() {
  local name="" from=this-machine to=github public=0 use=0 dest="" repo="" tok="" src stage sticks n a
  while (( $# )); do
    case $1 in
      --from) val "$1" "${2:-}" "this-machine, a profile, or empty"; from=$2; shift ;;
      --to) val "$1" "${2:-}" "github, file, file:PATH, stick or stick:NAME"; to=$2; shift ;;
      --public) public=1 ;;
      --use) use=1 ;;
      -*) die "new: unknown option $1" ;;
      *) [[ -z $name ]] || die "new: one name (got $name and $1)"; name=$1 ;;
    esac; shift
  done
  [[ $name =~ ^[A-Za-z0-9_.-]+$ ]] || die "new: a name like decal-work (letters, digits, - _ .)"
  case $to in   # where, checked first
    github) ;;
    file) dest="$HOME/$name.tar.gz" ;;
    file:*) dest=${to#file:}; dest=${dest/#\~/$HOME} ;;
    stick)
      mapfile -t sticks < <(python3 "$LS_REPO/lib/profiles.py" sticks | sed '/^$/d')
      (( ${#sticks[@]} )) || die "no USB stick found: plug in a USB stick and try again"
      if (( ${#sticks[@]} == 1 )); then dest="${sticks[0]}/.Decal/profile"
      else
        { : < "${DECAL_TTY_IN:-/dev/tty}"; } 2>/dev/null || die "several USB sticks: unplug the others"
        n=0; for a in "${sticks[@]}"; do n=$((n + 1)); printf '  %s) %s\n' "$n" "$(basename "$a")" >> "${DECAL_TTY_OUT:-/dev/tty}"; done
        printf 'Which stick? ' >> "${DECAL_TTY_OUT:-/dev/tty}"; IFS= read -r a < "${DECAL_TTY_IN:-/dev/tty}"
        if ! [[ $a =~ ^[0-9]+$ ]] || (( a < 1 || a > ${#sticks[@]} )); then die "no stick chosen"; fi
        dest="${sticks[$((a - 1))]}/.Decal/profile"
      fi ;;
    *) die "new: --to github, file, file:PATH or stick" ;;
  esac
  if [[ -n $dest && -e $dest ]]; then die "$dest already exists: use decal stamp to update it"; fi
  if [[ $to == github ]]; then
    tok=$(gh_write_token)
    if [[ -z $tok ]]; then gh_auth "$name" write --may-create || die "no GitHub key: sign in when asked, set GITHUB_TOKEN, or log in with gh auth login"; tok=$GITHUB_TOKEN; fi
    repo="$(GITHUB_TOKEN=$tok python3 "$LS_REPO/lib/github.py" whoami)/$name" || die "GitHub didn't accept the key"
    if GITHUB_TOKEN=$tok python3 "$LS_REPO/lib/github.py" exists "$repo"; then die "github:$repo already exists: use decal stamp -gh $repo to update it"; fi
  fi
  stage="$LS_RUNTMP/new/$name"
  case $from in   # what goes in
    this-machine) do_stamp "$stage" ;;
    empty) python3 "$LS_REPO/lib/profiles.py" empty "$stage" ;;
    *) stage_profile "$from"; mkdir -p "$stage"; cp -a "$STAGE_DIR/." "$stage/"; rm -rf "$stage/.git" "$stage/.decal-source" ;;
  esac
  rm -f "$stage/.decal-stamp"
  python3 "$LS_REPO/lib/profiles.py" readme "$stage" "$name" "$( [[ $from == this-machine || $from == empty ]] && echo "$from" || echo "${STAGE_SRC:-$from}")"
  case $to in   # where it goes
    github)
      local pub=(); if (( public )); then pub=(--public); fi
      GITHUB_TOKEN=$tok python3 "$LS_REPO/lib/github.py" push "$stage" "$repo" "${pub[@]}" --message "decal new: $name" >/dev/null \
        || die "could not create github:$repo"
      src="github:$repo" ;;
    stick) mkdir -p "$dest"; cp -a "$stage/." "$dest/"; : > "$dest/.decal-stamp"; src=$dest ;;
    *) mkdir -p "$(dirname "$dest")"; tar -czf "$dest" -C "$stage" .; src=$dest ;;
  esac
  info "new profile: $src"
  if (( use )); then set_profile "$src"; python3 "$LS_REPO/lib/source.py" remember "$STAGE_SRC" || true; fi
}
# usb_bin : a folder with the launchers (Decal-x86_64, Decal-aarch64): the release's usb/bin, else downloaded once
usb_bin() {
  local d=${DECAL_USB_BIN:-$LS_REPO/usb/bin} c="${XDG_CACHE_HOME:-$HOME/.cache}/decal/usb-bin" t
  if [[ -f $d/Decal-x86_64 ]]; then echo "$d"; return 0; fi
  if [[ -f $c/Decal-x86_64 ]]; then echo "$c"; return 0; fi
  info "getting the stick launchers (this copy of decal doesn't have them)"
  t=$(mktemp -d "$LS_RUNTMP/rel.XXXXXX")
  if ! curl -fsSL --proto =https --proto-redir =https https://github.com/dmacpherson/decal/releases/latest/download/decal.tar.gz -o "$t/d.tgz" \
     || ! curl -fsSL --proto =https --proto-redir =https https://github.com/dmacpherson/decal/releases/latest/download/decal.tar.gz.sha256 -o "$t/sum"; then
    die "couldn't download the stick launchers"
  fi
  [[ $(sha256sum "$t/d.tgz" | cut -d' ' -f1) == "$(cut -d' ' -f1 < "$t/sum")" ]] || die "the launchers download is damaged"
  tar -xzf "$t/d.tgz" -C "$t" decal/usb/bin 2>/dev/null || die "the latest release has no stick launchers yet"
  mkdir -p "$c"; cp "$t/decal/usb/bin/"* "$c/"; echo "$c"
}
# do_usb [--from SRC] [--how saved-key|sign-in|copy|latest] [--decal newest|copy|online] [--arm]
#        [--to MOUNTPOINT|DEVICE|folder[:PATH]] [--yes] : put decal on a USB stick (or in a folder)
do_usb() {
  local prof="" how="" dmode=newest arm=0 to="" yes=0 target files key="" kind src ver bin how_text a res
  while (( $# )); do
    case $1 in
      --from) val "$1" "${2:-}" "a profile (a folder, a link or owner/name)"; prof=$2; shift ;;
      --how) val "$1" "${2:-}" "saved-key, sign-in, copy or latest"; how=$2; shift ;;
      --decal) val "$1" "${2:-}" "newest, copy or online"; dmode=$2; shift ;;
      --to) val "$1" "${2:-}" "a mount point, a device, or folder[:PATH]"; to=$2; shift ;;
      --arm) arm=1 ;; --yes|-y) yes=1 ;;
      *) die "usb: unknown option $1" ;;
    esac; shift
  done
  if [[ ${DECAL_YES:-} == 1 ]]; then yes=1; fi   # --yes is decal's own option (it reaches here as DECAL_YES)
  [[ $dmode =~ ^(newest|copy|online)$ ]] || die "usb: --decal newest, copy or online"
  # where
  case $to in
    folder) target="$HOME/decal-usb" ;;
    folder:*) target=${to#folder:}; target=${target/#\~/$HOME} ;;
    /dev/*) target=$(python3 "$LS_REPO/lib/usb.py" mount "$to") || exit 1 ;;
    "") mapfile -t a < <(python3 "$LS_REPO/lib/usb.py" drives | awk -F'\t' '$3 != "" {print $3}')
        (( ${#a[@]} == 1 )) || die "usb: which drive? --to a mount point, a device, or folder (decal usb in a terminal asks)"
        target=${a[0]} ;;
    *) [[ -d $to ]] || die "usb: $to isn't a folder or a mounted drive"; target=$to ;;
  esac
  # which profile (the active one by default)
  if [[ -z $prof ]]; then
    if [[ -L $PROFILE_HOME ]]; then prof=$(readlink -f "$PROFILE_HOME"); else prof=$(cat "$PROFILE_HOME/.decal-source" 2>/dev/null || true); fi
    [[ -n $prof ]] || die "usb: which profile? --from SOURCE (there's no active profile)"
  fi
  stage_profile "$prof"; kind=$STAGE_KIND; src=$STAGE_SRC
  if [[ $kind == github ]]; then
    if [[ -z $how ]]; then if python3 "$LS_REPO/lib/source.py" public "$src"; then how=latest; else how=saved-key; fi; fi
  else
    [[ -z $how || $how == copy ]] || die "usb: $src isn't on GitHub: the stick gets a copy (--how copy)"
    how=copy
  fi
  [[ $how =~ ^(saved-key|sign-in|copy|latest)$ ]] || die "usb: --how saved-key, sign-in, copy or latest"
  # the key: always a fresh read key, never GITHUB_TOKEN / GH_TOKEN / gh
  if [[ $how == saved-key ]]; then
    if [[ -n ${DECAL_STICK_KEY:-} ]]; then key=$DECAL_STICK_KEY
    else
      { : < "${DECAL_TTY_IN:-/dev/tty}"; } 2>/dev/null || die "usb: a saved key needs a terminal to sign in (or DECAL_STICK_KEY)"
      info "the stick gets its own read-only key (your gh login or GITHUB_TOKEN are never put on a stick)"
      key=$(env -u GITHUB_TOKEN -u GH_TOKEN python3 "$LS_REPO/lib/auth.py" get "${src#github:}" --need read) || die "no key: nothing written"
    fi
  fi
  if [[ -n $key ]] && ! GITHUB_TOKEN=$key python3 "$LS_REPO/lib/auth.py" stick-ok 2>/dev/null; then
    die "that key can write to your repos: it's not put on a stick (use Sign in with GitHub, or a read-only token)"
  fi
  bin=$(usb_bin) || exit 1
  ver=$(cat "$LS_REPO/VERSION" 2>/dev/null || echo "dev-$(git -C "$LS_REPO" rev-parse --short HEAD 2>/dev/null || echo local)")
  files="$LS_RUNTMP/stick"; rm -rf "$files"; mkdir -p "$files/.Decal"
  cp "$bin/Decal-x86_64" "$files/Decal"
  if (( arm )); then cp "$bin/Decal-aarch64" "$files/.Decal/Decal-ARM"; fi
  cp "$LS_REPO/usb/start.sh" "$files/.Decal/start.sh"
  case $how in
    copy) mkdir -p "$files/.Decal/profile"; cp -a "$STAGE_DIR/." "$files/.Decal/profile/"
          rm -rf "$files/.Decal/profile/.git" "$files/.Decal/profile/.decal-source"; : > "$files/.Decal/profile/.decal-stamp"
          how_text="a copy of $src" ;;
    saved-key) ( umask 077; printf '%s\n' "$key" > "$files/.Decal/key" ); how_text="$src (with a read-only key)" ;;
    sign-in) how_text="$src (signs in each time)" ;;
    latest) how_text="$src (public: always the latest)" ;;
  esac
  if [[ $dmode != online ]]; then   # this decal's own files (installed or a checkout), without .git, tests or docs
    tar -czf "$files/.Decal/decal.tar.gz" -C "$(dirname "$LS_REPO")" --exclude=.git --exclude=tests --exclude=docs \
      --exclude=__pycache__ --exclude=.superpowers --transform "s,^$(basename "$LS_REPO"),decal," "$(basename "$LS_REPO")"
    (cd "$files/.Decal" && sha256sum decal.tar.gz > decal.tar.gz.sha256)
  fi
  { echo "# Made by decal $ver on $(date +%F). Run decal usb to change it."
    if [[ $how == copy ]]; then echo "profile=copy"; else echo "profile=$src"; fi
    case $how in saved-key) echo "key=saved" ;; sign-in) echo "key=ask" ;; *) echo "key=none" ;; esac
    echo "decal=$dmode"; echo "version=$ver"; } > "$files/.Decal/stick.conf"
  sed -e "s|{profile}|$how_text|" -e "s|{version}|$ver ($dmode)|" -e "s|{made}|$(date +%F)|" "$LS_REPO/usb/README.txt" > "$files/.Decal/README.txt"
  local fs; fs=$(findmnt -no FSTYPE --target "$target" 2>/dev/null || true)
  if [[ $fs == vfat || $fs == msdos ]]; then
    printf '\nThis stick is FAT32: Linux mounts it so nothing on it can be started by double-clicking. Start decal\nfrom a terminal instead:  bash .Decal/start.sh   (or reformat the stick as exFAT; Ventoy sticks are exFAT).\n' >> "$files/.Decal/README.txt"
  fi
  info "on $target:"; (cd "$files" && find Decal .Decal -type f | sort | sed 's/^/    /') >&2
  if (( ! yes )); then
    { : < "${DECAL_TTY_IN:-/dev/tty}"; } 2>/dev/null || die "usb: nothing written: add --yes to write without asking"
    printf 'Write these to %s? [Y/n] ' "$target" >> "${DECAL_TTY_OUT:-/dev/tty}"; IFS= read -r a < "${DECAL_TTY_IN:-/dev/tty}" || a=n
    [[ ${a:-y} == [Yy]* ]] || die "nothing written"
  fi
  res=$(python3 "$LS_REPO/lib/usb.py" write "$target" "$files") || exit 1   # usb.py says why
  info "done: double-click Decal on any Linux PC (Ctrl+H shows the .Decal folder)"
  if (( arm )); then info "ARM machines: double-click .Decal/Decal-ARM"; fi
  if [[ $fs == vfat || $fs == msdos ]]; then warn "this stick is FAT32: double-clicking Decal won't work on it; start it with: bash .Decal/start.sh (or use an exFAT stick)"; fi
  if [[ $res == upgraded ]]; then warn "the old hand-made setup was replaced: revoke its token on GitHub (Settings → Developer settings → tokens)"; fi
  if [[ $target == "$HOME"/* || $to == folder* ]]; then info "copy Decal and .Decal/ together; zipping or some cloud drives drop the 'can run' bit Decal needs"; fi
}
# tidy_cache : one version per source, nothing unused for 30 days (after a successful apply/fetch)
tidy_cache() { if [[ ${LS_DRY_RUN:-0} != 1 ]]; then python3 "$LS_REPO/lib/fetch.py" --prune || warn "could not tidy the download cache"; fi; }
find_profile_root() {  # DIR -> folder holding profile.toml (DIR or its single sub-folder)
  if [[ -f $1/profile.toml ]]; then echo "$1"; return 0; fi
  local subs=("$1"/*/)
  if [[ ${#subs[@]} -eq 1 && -f ${subs[0]}profile.toml ]]; then echo "${subs[0]%/}"; return 0; fi
  return 1
}
# gh_tarball OWNER/REPO REF OUT : a GitHub repo as a .tar.gz without git. Private repos need a key: GITHUB_TOKEN,
# GH_TOKEN or a `gh auth login`; without one, in a terminal, it asks (sign in with GitHub, or a token you make)
gh_token() {   # from a USB stick (a borrowed PC): only the stick's own key (start.sh sets GITHUB_TOKEN), never GH_TOKEN or gh
  if [[ -n ${DECAL_STICK:-} ]]; then printf '%s' "${GITHUB_TOKEN:-}"; return 0; fi
  local t=${GITHUB_TOKEN:-${GH_TOKEN:-}}; if [[ -z $t ]] && have gh; then t=$(gh auth token 2>/dev/null || true); fi; printf '%s' "$t"
}
# gh_write_token : a key to write to GitHub with: from a USB stick (a borrowed PC) never the PC's GITHUB_TOKEN, GH_TOKEN
# or gh login, only this menu session's key (DECAL_WRITE_KEY) or a fresh sign-in; elsewhere, the usual order
gh_write_token() { if [[ -n ${DECAL_STICK:-} ]]; then printf '%s' "${DECAL_WRITE_KEY:-}"; else gh_token; fi; }
# gh_auth REPO read|write [--may-create] : ask on the terminal for a key (lib/auth.py: sign in with a code or QR,
# or paste a token); exported as GITHUB_TOKEN for the rest of this run, never saved. No terminal or cancelled: fails
gh_auth() {
  if [[ -z ${DECAL_TTY_IN:-} ]]; then { : < /dev/tty; } 2>/dev/null || return 1; fi
  local t; t=$(python3 "$LS_REPO/lib/auth.py" get "$1" --need "$2" "${@:3}") || return 1
  [[ -n $t ]] || return 1
  export GITHUB_TOKEN=$t
}
gh_tarball() {
  local url="${DECAL_GITHUB_API:-https://api.github.com}/repos/$1/tarball${2:+/$2}" tok code asked=0
  have curl || die "curl is needed to download $1"
  tok=$(gh_token)
  while :; do
    # the key goes to curl on its stdin (printf is a builtin): never on a command line, never in a file
    code=$(if [[ -n $tok ]]; then printf 'Authorization: Bearer %s\n' "$tok"; fi \
           | curl -sSL --proto =https --proto-redir =https --connect-timeout 10 -H @- -o "$3" -w '%{http_code}' "$url" 2>/dev/null) \
      || code=${code:-000}
    [[ $code == 200 ]] && return 0
    if [[ $code =~ ^(401|403|404)$ && $asked == 0 ]]; then
      asked=1
      if gh_auth "$1" read; then tok=$GITHUB_TOKEN; continue; fi
    fi
    case $code in
      401|403|404) die "github:$1 not found or not allowed (private? set GITHUB_TOKEN, or log in with gh auth login)" ;;
      000) die "couldn't reach GitHub to get github:$1: check the internet connection" ;;
      *) die "could not download github:$1 (GitHub answered $code)" ;;
    esac
  done
}
# stage_profile SOURCE : SOURCE as a validated folder holding profile.toml, in STAGE_DIR (a folder source as is;
# anything else downloaded/unpacked into a temp folder); STAGE_KIND and STAGE_SRC (canonical) set too. Not run in
# a subshell: a sign-in it needs lasts the whole run.
stage_profile() {
  local r note tmp rc
  r=$(python3 "$LS_REPO/lib/source.py" resolve "$1") || exit 1   # the reason is already on stderr
  IFS=$'\t' read -r STAGE_KIND STAGE_SRC note <<<"$r"
  if [[ -n $note ]]; then info "$note"; fi
  case $STAGE_KIND in
    dir)
      [[ -f $STAGE_SRC/profile.toml ]] || die "$STAGE_SRC has no profile.toml"
      STAGE_DIR=$(cd "$STAGE_SRC" && pwd -P); STAGE_SRC=$STAGE_DIR ;;
    archive)
      tmp=$(mktemp -d "$LS_RUNTMP/profile.XXXXXX")
      python3 "$LS_REPO/lib/source.py" unpack "$STAGE_SRC" "$tmp/x" || die "could not unpack $STAGE_SRC"
      STAGE_DIR=$(find_profile_root "$tmp/x") || die "$STAGE_SRC contains no profile.toml" ;;
    github)
      [[ $STAGE_SRC =~ ^github:([^@]+)(@(.+))?$ ]] || die "not a GitHub source: $STAGE_SRC"
      tmp=$(mktemp -d "$LS_RUNTMP/profile.XXXXXX")
      gh_tarball "${BASH_REMATCH[1]}" "${BASH_REMATCH[3]}" "$tmp/p.tar.gz"
      python3 "$LS_REPO/lib/source.py" unpack "$tmp/p.tar.gz" "$tmp/x" || die "could not unpack $STAGE_SRC"
      STAGE_DIR=$(find_profile_root "$tmp/x") || die "$STAGE_SRC has no profile.toml" ;;
    url)
      tmp=$(mktemp -d "$LS_RUNTMP/profile.XXXXXX"); rc=0
      python3 "$LS_REPO/lib/source.py" fetch "$STAGE_SRC" "$tmp/x" >/dev/null || rc=$?
      if (( rc == 0 )); then
        STAGE_DIR=$(find_profile_root "$tmp/x") || die "$STAGE_SRC: the archive has no profile.toml"
      elif (( rc == 3 )) && have git && git clone -q "$STAGE_SRC" "$tmp/p" 2>/dev/null && [[ -f $tmp/p/profile.toml ]]; then
        STAGE_KIND=git; STAGE_DIR=$tmp/p
      else
        (( rc != 3 )) || die "$STAGE_SRC isn't a decal profile (not an archive with a profile.toml, nor a git repo with one)"
        exit 1   # source.py said why
      fi ;;
    git)
      tmp=$(mktemp -d "$LS_RUNTMP/profile.XXXXXX")
      git clone -q "${STAGE_SRC#git+}" "$tmp/p" || die "git clone failed: ${STAGE_SRC#git+}"
      [[ -f $tmp/p/profile.toml ]] || die "${STAGE_SRC#git+} has no profile.toml"
      STAGE_DIR=$tmp/p ;;
  esac
  python3 "$LS_REPO/lib/profile.py" check --profile "$STAGE_DIR" --modules "$MODULES_DIR" \
    || die "$STAGE_SRC: the profile is invalid (the active profile was not changed)"
}
# set_profile SOURCE : make SOURCE the active profile at $PROFILE_HOME (dry-run: only staged)
set_profile() { stage_profile "$1"; activate_staged; }
# activate_staged : the profile stage_profile got (STAGE_*) becomes the active one. A replaced real folder is kept as
# a dated backup, except a newer download of the same GitHub repo or link.
activate_staged() {
  local t=$PROFILE_HOME
  _aside() {  # move the active profile out of the way (a symlink is just dropped)
    local b
    if [[ -L $t ]]; then rm -f "$t"
    elif [[ -e $t ]]; then b="$t.old-$(date +%Y%m%d-%H%M%S)"; [[ ! -e $b ]] || b+="-$$"; mv "$t" "$b"; info "previous profile kept at $b"; fi
    mkdir -p "$(dirname "$t")"
  }
  _beside() {  # the new profile beside the active one first (same filesystem: the swap is then renames, never a copy)
    mkdir -p "$(dirname "$t")"; rm -rf "$t.decal-new" "$t.decal-old"
    cp -a "$STAGE_DIR" "$t.decal-new" || { rm -rf "$t.decal-new"; die "couldn't put the profile in place (the active one is untouched)"; }
  }
  if [[ ${LS_DRY_RUN:-0} == 1 ]]; then PROFILE_DIR=$STAGE_DIR; return 0; fi
  case $STAGE_KIND in
    dir)
      if [[ -e $t && $(readlink -f "$t") == "$STAGE_DIR" ]]; then PROFILE_DIR=$t; info "$STAGE_DIR is already the active profile"; return 0; fi
      _aside; ln -s "$STAGE_DIR" "$t" ;;
    git)
      if [[ -d $t/.git && ! -L $t && $(git -C "$t" remote get-url origin 2>/dev/null) == "${STAGE_SRC#git+}" ]]; then
        git -C "$t" pull -q --ff-only || die "git pull failed in $t"
      else _beside; _aside; mv "$t.decal-new" "$t"; fi ;;
    *)   # archive, github, url: an unpacked copy
      echo "$STAGE_SRC" > "$STAGE_DIR/.decal-source"
      _beside
      if [[ $STAGE_KIND != archive && -d $t && ! -L $t && $(cat "$t/.decal-source" 2>/dev/null) == "$STAGE_SRC" ]]; then
        mv "$t" "$t.decal-old"   # a newer download of the same source: no backup, gone once the new one is in
      else _aside; fi
      mv "$t.decal-new" "$t"; rm -rf "$t.decal-old" ;;
  esac
  PROFILE_DIR=$t
  info "active profile: $t -> $(readlink -f "$t")"
}
# trust SOURCE : a profile that isn't yours (lib/source.py yours): say whose it is, offer a preview, ask.
# --yes / DECAL_YES=1 skips the question; no terminal: stops with how to go on.
trust() {   # trust SOURCE [VERB] : VERB is what "y" does (apply it / use it)
  local src=$1 verb=${2:-apply} login="" tok a fd done=applied
  if [[ $verb == use ]]; then done=used; fi
  if [[ ${DECAL_YES:-} == 1 ]]; then return 0; fi   # asked not to ask (the installer: you typed the source)
  if [[ $src == github:* ]]; then tok=$(gh_token); if [[ -n $tok ]]; then login=$(GITHUB_TOKEN=$tok python3 "$LS_REPO/lib/github.py" whoami 2>/dev/null || true); fi; fi
  if python3 "$LS_REPO/lib/source.py" yours "$src" --login "$login"; then return 0; fi
  warn "this profile is from ${src#github:}, not you: it can install software and change system settings"
  if [[ -z ${DECAL_TTY_IN:-} ]] && ! { : < /dev/tty; } 2>/dev/null; then die "not $done: to $verb it anyway, run decal --yes $verb $src"; fi
  exec {fd}<"${DECAL_TTY_IN:-/dev/tty}"
  while :; do
    printf 'p preview what it would change · y %s it · n stop [p]: ' "$verb" >> "${DECAL_TTY_OUT:-/dev/tty}"
    IFS= read -r a <&"$fd" || a=n
    case ${a:-p} in
      p|P) DECAL_NO_UPDATE=1 DECAL_YES=1 DECAL_PROFILE=$STAGE_DIR "$LS_REPO/decal" --dry-run add all || true ;;
      y|Y) exec {fd}<&-; return 0 ;;
      *) die "not $done" ;;
    esac
  done
}

LS_RUNTMP="$(mktemp -d "${TMPDIR:-/tmp}/decal.XXXXXX")"; export LS_RUNTMP
export TMPDIR="$LS_RUNTMP"   # temp files modules make go with the run (removed on exit)
trap 'rm -rf "$LS_RUNTMP"' EXIT

case $cmd in
  list)
    for m in $(all_modules); do printf '%-18s %s\n' "$m" "$(module_field "$m" MODULE_DESC)"; done ;;
  status)
    check_tags
    if [[ $# -gt 0 ]]; then names=$(resolve "$@") || exit 1; else names=$(all_modules); fi
    mapfile -t mods < <(only_filter <<<"$names")
    for m in "${mods[@]}"; do
      set +e; res=$(run_module status "$m" 2>"$LS_RUNTMP/err"); rc=$?; set -e
      (( rc == 0 )) || res="error: $(tail -1 "$LS_RUNTMP/err")"
      if ! in_profile "$m"; then
        tg=$(module_tags "$m" | paste -sd, -)
        if [[ -n $tg ]]; then where="tags: $tg"; else where="not in profile"; fi
        if [[ $res == not-installed* ]]; then res="not in profile${tg:+ ($where)}"; else res="$res ($where)"; fi
      fi
      printf '%-18s %s\n' "$m" "$res"
    done ;;
  tags)
    tg=$(DECAL_TAGS="" pyprof tags) || exit 1
    [[ -n $tg ]] || { info "your profile has no tags (add e.g. [apps.dev] to give dev machines extra settings)"; exit 0; }
    while IFS= read -r t; do
      printf '%-12s %s\n' "$t" "$(for m in $(all_modules); do module_tags "$m" | grep -qxF "$t" && printf '%s ' "$m"; done)"
    done <<<"$tg" ;;
  capture)
    [[ $# -eq 1 ]] || usage
    m=$(resolve "$1")
    set +e; run_module capture "$m"; rc=$?; set -e
    [[ $rc == 2 ]] && die "$m has no capture"; exit $rc ;;
  add|remove)
    [[ $# -ge 1 ]] || usage
    if [[ $cmd == add ]]; then
      pyprof check || die "fix $PROFILE_DIR/profile.toml first (nothing was changed)"
      if [[ $# -eq 1 && $1 == all ]]; then names=$(profile_modules); else names=$(resolve "$@") || exit 1; fi
    else
      check_tags
      names=$(resolve "$@") || exit 1   # not "< <(resolve)": die in a process substitution can't stop us
    fi
    if [[ -n ${DECAL_ONLY:-} && ! ($# -eq 1 && $1 == all) ]]; then
      for m in $names; do has_tag "$m" || info "$m has no [$m.$DECAL_ONLY] section: skipped (--only $DECAL_ONLY)"; done
    fi
    mapfile -t mods < <(only_filter <<<"$names")
    if [[ $cmd == add ]]; then
      for m in "${mods[@]}"; do
        in_profile "$m" && continue
        tg=$(module_tags "$m" | paste -sd, -)
        if [[ -n $tg && ! ($# -eq 1 && $1 == all) ]]; then   # named on its own: its tags' settings, just for it
          MODULE_TAGS[$m]=$tg; info "$m: using its [$m.${tg//,/] / [$m.}] settings (only for $m)"; continue
        fi
        die "$m is not in your profile (add a [$m] section to $PROFILE_DIR/profile.toml)"
      done
      do_modules add "${mods[@]}"
      remember_tags; remember_active
    elif [[ -n ${DECAL_ONLY:-} ]]; then
      # remove --only TAG: a module that is only in the profile through the tag goes; one that is there anyway
      # keeps its own settings and only loses what the tag adds to its lists (if it can take that away)
      whole=(); part=()
      for m in "${mods[@]}"; do
        if DECAL_TAGS="" in_profile "$m"; then part+=("$m"); else whole+=("$m"); fi
      done
      for m in "${part[@]}"; do
        if [[ $(module_field "$m" MODULE_CAN_DROP) != 1 ]]; then
          warn "$m: what $DECAL_ONLY adds to it is left in place (it has no way to take part of itself away)"
          mapfile -t part < <(printf '%s\n' "${part[@]}" | grep -vxF "$m")
        fi
      done
      mapfile -t whole < <(printf '%s\n' "${whole[@]}" | sed '/^$/d' | tac)
      do_modules remove "${whole[@]}"
      do_modules drop "${part[@]}"
    else
      mapfile -t mods < <(printf '%s\n' "${mods[@]}" | tac)
      do_modules remove "${mods[@]}"
    fi
    if [[ -e $LS_RUNTMP/reboot ]]; then info "reboot required to finish"; fi ;;
  apply)
    [[ $# -ge 1 ]] || usage
    stage_profile "$1"
    if [[ ${LS_DRY_RUN:-0} != 1 ]]; then trust "$STAGE_SRC"; fi
    activate_staged; export PROFILE_DIR; shift   # exactly the copy that was previewed: nothing downloaded again
    pyprof check || die "$PROFILE_DIR/profile.toml is invalid (nothing was added)"
    if (( $# )); then   # apply SOURCE MODULE...: that profile, just those modules (as decal add would)
      set +e; DECAL_PROFILE=$PROFILE_DIR "$LS_REPO/decal" add "$@"; rc=$?; set -e
      tidy_cache; exit "$rc"
    fi
    mapfile -t mods < <(profile_modules | only_filter)
    do_modules add "${mods[@]}"
    remember_tags; remember_active
    tidy_cache
    if [[ -e $LS_RUNTMP/reboot ]]; then info "reboot required to finish"; fi ;;
  profiles)
    signin=0; pargs=()
    for a in "$@"; do case $a in --sign-in) signin=1 ;; --json) pargs+=(--json) ;; --only=*) pargs+=(--only "${a#--only=}") ;; *) die "profiles: unknown option $a" ;; esac; done
    tok=$(gh_token)
    if [[ -z $tok ]] && (( signin )); then gh_auth - read || die "not signed in"; tok=$GITHUB_TOKEN; fi
    GITHUB_TOKEN=$tok python3 "$LS_REPO/lib/profiles.py" list "${pargs[@]}" ;;
  whoami)   # the GitHub login of the key decal would use (GITHUB_TOKEN, GH_TOKEN, gh); none: exit 1
    tok=$(gh_token); [[ -n $tok ]] || exit 1
    GITHUB_TOKEN=$tok python3 "$LS_REPO/lib/github.py" whoami 2>/dev/null ;;
  stamp) do_stamp "$@" ;;
  new) do_new "$@" ;;
  usb) if [[ $# -eq 0 && -t 0 && -t 1 ]]; then exec python3 "$LS_REPO/lib/ui.py" usb; fi; do_usb "$@" ;;
  use)
    [[ $# -eq 1 ]] || usage
    stage_profile "$1"
    if [[ ${LS_DRY_RUN:-0} != 1 ]]; then trust "$STAGE_SRC" use; fi   # someone else's profile asks here too (the menu uses use)
    activate_staged
    info "active profile: $PROFILE_DIR (nothing applied yet: decal add all, or the menu)" ;;
  ui)
    [[ -t 0 && -t 1 ]] || die "the menu needs a terminal"
    exec python3 "$LS_REPO/lib/ui.py" ;;
  fetch)
    if [[ $# -gt 0 ]]; then names=$(resolve "$@") || exit 1; else names=$(profile_modules); fi
    mapfile -t mods < <(printf '%s\n' "$names" | sed '/^$/d')
    for m in "${mods[@]}"; do
      set +e; run_module fetch "$m" 2>"$LS_RUNTMP/err"; rc=$?; set -e
      if (( rc != 0 && rc != 2 )); then cat "$LS_RUNTMP/err" >&2; fi
      (( rc == 0 || rc == 2 )) || die "fetch $m failed"
    done
    tidy_cache ;;
  *) usage ;;
esac
